---
type ScanSummary = {
	violations?: number;
	incomplete?: number;
	passes?: number;
	inapplicable?: number;
};

type AccessibilitySummaryDocument = {
	source?: {
		aggregateHtmlHref?: string;
		summary?: {
			scanSummaries?: {
				'page-state'?: ScanSummary;
				'matched-surface'?: ScanSummary;
			};
		};
	};
};

type Props = {
	accessibilityDocument: AccessibilitySummaryDocument;
};

const { accessibilityDocument } = Astro.props;
const scanSummaries = accessibilityDocument.source?.summary?.scanSummaries ?? {};
const reportHref = accessibilityDocument.source?.aggregateHtmlHref;

function metric(summary: ScanSummary | undefined, key: keyof ScanSummary): number {
	const value = summary?.[key];
	return typeof value === 'number' ? value : 0;
}

const rows = [
	{ label: 'Page state', summary: scanSummaries['page-state'] },
	{ label: 'Matched surface', summary: scanSummaries['matched-surface'] },
];
---

<section class="accessibility-intro" aria-labelledby="accessibility-intro-title">
	<div class="accessibility-intro__header header">
		<h3>Summary</h3>

		<div class="accessibility-intro__chips" aria-label="Accessibility test coverage">
			<span class="accessibility-intro__chip accessibility-intro__chip--standards">
				<svg aria-hidden="true" viewBox="0 0 24 24">
					<path d="M12 3 5.5 5.7v5.1c0 4.2 2.7 8 6.5 9.2 3.8-1.2 6.5-5 6.5-9.2V5.7L12 3Z" />
					<path d="m9 12 2 2 4-5" />
				</svg>
				<span>WCAG 2.0 A/AA · 2.1 A/AA · 2.2 AA</span>
			</span>
			<span class="accessibility-intro__chip accessibility-intro__chip--blue">
				<svg aria-hidden="true" viewBox="0 0 24 24">
					<rect x="3" y="6" width="18" height="12" rx="2" />
					<path d="M7 10h.01M11 10h.01M15 10h.01M19 10h.01M7 14h.01M11 14h6" />
				</svg>
				<span>Case 1: Keyboard-only</span>
			</span>
			<span class="accessibility-intro__chip accessibility-intro__chip--blue">
				<svg aria-hidden="true" viewBox="0 0 24 24">
					<path d="m5 3 13 9-6 1.5 4 6-3 1.7-4-6-4 5V3Z" />
				</svg>
				<span>Case 2: Default interaction</span>
			</span>
		</div>

		<p class="accessibility-intro__note">Two interaction modes tested</p>
	</div>

	<div class="federation-diagram" aria-label="Federated file sharing test context">
		<div class="federation-diagram__side federation-diagram__side--left">
			<div class="federation-diagram__badge">
				<svg aria-hidden="true" viewBox="0 0 24 24">
					<path d="M7 18h10a4 4 0 0 0 .4-8 6 6 0 0 0-11.2-1.7A4.8 4.8 0 0 0 7 18Z" />
				</svg>
				<span>Nextcloud A</span>
			</div>
			<div class="federation-diagram__badge federation-diagram__badge--user">
				<svg aria-hidden="true" viewBox="0 0 24 24">
					<circle cx="12" cy="8" r="3.25" />
					<path d="M5.5 20a6.5 6.5 0 0 1 13 0" />
				</svg>
				<span>Alice</span>
			</div>
		</div>

		<svg class="federation-diagram__arrow up" aria-hidden="true" viewBox="0 0 24 24">
			<path d="M5 12h14M13 6l6 6-6 6" />
		</svg>

		<div class="federation-diagram__artifact muted-bg" aria-hidden="true">
			<svg viewBox="0 0 24 24">
				<path d="M6 3h8l4 4v14H6V3Z" />
				<path d="M14 3v5h5" />
				<path d="M9 12h6M9 16h6" />
			</svg>
		</div>

		<svg class="federation-diagram__arrow down" aria-hidden="true" viewBox="0 0 24 24">
			<path d="M5 12h14M13 6l6 6-6 6" />
		</svg>

		<div class="federation-diagram__side federation-diagram__side--right">
			<div class="federation-diagram__badge">
				<svg aria-hidden="true" viewBox="0 0 24 24">
					<path d="M7 18h10a4 4 0 0 0 .4-8 6 6 0 0 0-11.2-1.7A4.8 4.8 0 0 0 7 18Z" />
				</svg>
				<span>Nextcloud B</span>
			</div>
			<div class="federation-diagram__badge federation-diagram__badge--user">
				<svg aria-hidden="true" viewBox="0 0 24 24">
					<circle cx="12" cy="8" r="3.25" />
					<path d="M5.5 20a6.5 6.5 0 0 1 13 0" />
				</svg>
				<span>Bob</span>
			</div>
		</div>
	</div>

	<section class="scan-metrics" aria-labelledby="scan-metrics-title">
		<div class="scan-metrics__header">
			<h4 id="scan-metrics-title">Scan metrics</h4>
			<a
				class:list={['scan-metrics__report-link', !reportHref && 'scan-metrics__report-link--hidden']}
				href={reportHref}
				aria-hidden={reportHref ? undefined : 'true'}
				tabindex={reportHref ? undefined : -1}
			>
				View full report <span aria-hidden="true">→</span>
			</a>
		</div>
		<div class="scan-metrics__table-wrap">
			<table>
				<thead>
					<tr>
						<th scope="col"></th>
						<th class="scan-metrics__metric scan-metrics__metric--danger" scope="col">Violations</th>
						<th class="scan-metrics__metric scan-metrics__metric--warning" scope="col">Incomplete</th>
						<th class="scan-metrics__metric scan-metrics__metric--success" scope="col">Passes</th>
						<th class="scan-metrics__metric scan-metrics__metric--muted" scope="col">Inapplicable</th>
					</tr>
				</thead>
				<tbody>
					{rows.map(({ label, summary }) => (
						<tr>
							<th scope="row">{label}</th>
							<td class="scan-metrics__metric scan-metrics__metric--danger">{metric(summary, 'violations')}</td>
							<td class="scan-metrics__metric scan-metrics__metric--warning">{metric(summary, 'incomplete')}</td>
							<td class="scan-metrics__metric scan-metrics__metric--success">{metric(summary, 'passes')}</td>
							<td class="scan-metrics__metric scan-metrics__metric--muted">{metric(summary, 'inapplicable')}</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
	</section>
</section>

<style>
	.accessibility-intro {
		display: grid;
		gap: calc(var(--spacing) * 5);
		
		margin-bottom: calc(var(--spacing) * 8);
		color: var(--foreground);
		margin-inline: auto;
	}

	.accessibility-intro__header {
		display: grid;
		gap: calc(var(--spacing) * 3);
	}

	.accessibility-intro h1 {
		margin: 0;
		color: var(--foreground);
		font-size: clamp(1.5rem, 5vw, 1.75rem);
		font-weight: 800;
		letter-spacing: 0;
		line-height: 1.12;
	}


	.accessibility-intro__chips {
		display: flex;
		flex-wrap: wrap;
		gap: calc(var(--spacing) * 2);
	}

	.muted-bg {
		background: color-mix(in oklab, var(--card) 86%, var(--background));
	}

	.accessibility-intro__chip,
	.federation-diagram__badge {
		display: inline-flex;
		align-items: center;
		gap: calc(var(--spacing) * 2);
		width: fit-content;
		border: 1px solid color-mix(in oklab, var(--border) 80%, transparent);
		border-radius: var(--radius);
		color: var(--foreground);
		font-weight: 600;
		line-height: 1.2;
	}

	.accessibility-intro__chip {
		min-height: 2.25rem;
		padding: 0 calc(var(--spacing) * 3);
		font-size: 0.875rem;
	}

	.accessibility-intro__chip--standards {
		
		background: color-mix(in oklab, var(--green-low) 28%, transparent);
	}

	.accessibility-intro__chip--blue {
		
		background: color-mix(in oklab, var(--blue-low) 28%, transparent);
	}

	

	.accessibility-intro svg {
		flex: 0 0 auto;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 2;
	}

	.accessibility-intro__chip svg {
		width: 1rem;
		height: 1rem;
	}

	.accessibility-intro__note {
		position: relative;
		margin: 0;
		padding-left: calc(var(--spacing) * 4);
		color: var(--muted-foreground);
		font-size: 0.875rem;
		line-height: 1.4;
	}

	.accessibility-intro__note::before {
		position: absolute;
		top: 0.62em;
		left: calc(var(--spacing) * 1);
		width: 0.3rem;
		height: 0.3rem;
		border-radius: 999px;
		background: currentColor;
		content: '';
	}

	.federation-diagram {
		width: min(100%, 600px);
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 9rem;
		margin-inline: auto;
		gap: clamp(1rem, 4vw, 2rem);
	}

	.federation-diagram__side {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: calc(var(--spacing) * 3);
		flex: 0 1 14rem;
		min-height: 8.25rem;
		background: color-mix(in oklab, var(--background) 88%, var(--card));
	}

	.federation-diagram__side--left {
		border-radius: var(--radius) 0 0 var(--radius);
		border-right: 0;
	}

	.federation-diagram__side--right {
		border-radius: 0 var(--radius) var(--radius) 0;
		border-left: 0;
	}

	.federation-diagram__badge {
		min-height: 2.25rem;
		padding: 0 calc(var(--spacing) * 3);
		font-size: 1rem;
	}

	.federation-diagram__badge--user {
		font-size: 0.875rem;
	}

	.federation-diagram__badge svg {
		width: 1rem;
		height: 1rem;
	}

	.federation-diagram__arrow {
		width: 2rem;
		height: 2rem;
		color: var(--foreground);

		&.up {
			transform: rotate(-45deg);
		}
		&.down {
			transform: rotate(125deg);
		}
	}

	.muted-bg {
				background: color-mix(in srgb, var(--muted) 72%, var(--card));

	}
	.federation-diagram__artifact {
		position: relative;
		z-index: 2;
		display: grid;
		place-items: center;
		flex: 0 0 5.5rem;
		width: 5.5rem;
		aspect-ratio: 1;
		margin-inline: auto;
		border-radius: 999px;
		color: var(--foreground);
	}

	.federation-diagram__artifact svg {
		width: 42%;
		height: 42%;
		fill: currentColor;
		stroke: none;
	}

	.federation-diagram__artifact svg path:nth-child(n + 2) {
		fill: none;
		stroke: var(--background);
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.7;
	}

	.scan-metrics {
		display: grid;
		gap: calc(var(--spacing) * 3);
		border: 1px solid color-mix(in oklab, var(--border) 80%, transparent);
		border-radius: var(--radius);
		padding: calc(var(--spacing) * 4);
		background: color-mix(in oklab, var(--background) 88%, var(--card));
		width: min(100%, 800px); 
		margin-inline: auto;

	}

	.scan-metrics h4 {
		margin: 0;
		color: var(--foreground);
		
		line-height: 1.2;
	}

	.scan-metrics__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: calc(var(--spacing) * 3);
	}

	.scan-metrics__report-link {
		display: inline-flex;
		align-items: center;
		gap: calc(var(--spacing) * 1);
		color: var(--blue);
		font-size: 0.875rem;
		font-weight: 700;
		line-height: 1.2;
		text-decoration: none;
		white-space: nowrap;
	}

	.scan-metrics__report-link--hidden {
		display: none;
	}

	.scan-metrics__report-link:hover {
		text-decoration: underline;
		text-underline-offset: 0.18em;
	}

	.scan-metrics__report-link:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 0.25rem;
		border-radius: calc(var(--radius) / 2);
	}

	.scan-metrics__table-wrap {
		overflow-x: auto;
		border: 1px solid color-mix(in oklab, var(--border) 70%, transparent);
		border-radius: var(--radius);
		thead  {
			background: color-mix(in oklab, var(--border) 20%, transparent);
		}
	}

	.scan-metrics table {
		width: 100%;
		min-width: 36rem;
		border-collapse: collapse;
		background: color-mix(in oklab, var(--card) 82%, var(--background));
	}

	.scan-metrics th,
	.scan-metrics td {
		border-bottom: 1px solid color-mix(in oklab, var(--border) 62%, transparent);
		border-left: 1px solid color-mix(in oklab, var(--border) 62%, transparent);
		padding: calc(var(--spacing) * 3);
		text-align: left;
		font-size: 0.875rem;
		line-height: 1.35;
	}

	.scan-metrics th:first-child,
	.scan-metrics td:first-child {
		border-left: 0;
	}

	.scan-metrics tr:last-child th,
	.scan-metrics tr:last-child td {
		border-bottom: 0;
	}

	.scan-metrics thead th,
	.scan-metrics tbody th {
		font-weight: 700;
	}

	.scan-metrics thead th:first-child {
		width: 26%;
	}

	.scan-metrics__metric--danger {
		color: var(--red);
	}

	.scan-metrics__metric--warning {
		color: var(--orange);
	}

	.scan-metrics__metric--success {
		color: var(--green);
	}

	.scan-metrics__metric--muted {
		color: var(--muted-foreground);
	}

	@media (max-width: 900px) {
		.federation-diagram {
			flex-direction: column;
			gap: calc(var(--spacing) * 3);
		}

		.federation-diagram__side,
		.federation-diagram__side--left,
		.federation-diagram__side--right {
			min-height: 10rem;
			
			border-radius: var(--radius);
		}

		.federation-diagram__artifact {
			order: 2;
		}

		.federation-diagram__arrow {
			transform: rotate(90deg);
		}

		.federation-diagram__arrow:first-of-type {
			order: 1;
		}

		.federation-diagram__arrow:last-of-type {
			order: 3;
		}

		.federation-diagram__side--right {
			order: 4;
		}
	}

	@media (max-width: 640px) {
		.accessibility-intro {
			gap: calc(var(--spacing) * 5);
			margin-bottom: calc(var(--spacing) * 7);
		}

		.accessibility-intro__chip {
			width: 100%;
			justify-content: flex-start;
		}

		.scan-metrics__header {
			align-items: flex-start;
			flex-direction: column;
			gap: calc(var(--spacing) * 2);
		}

		.scan-metrics {
			padding: calc(var(--spacing) * 4);
		}
	}
</style>
