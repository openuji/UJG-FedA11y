---
import { Icon } from '@astrojs/starlight/components';
import { Image } from 'astro:assets';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline: heroTagline, image, actions = [] } = data.hero || {};
const heroLayout = (data.hero as any)?.layout ?? 'centered';
const announcement = (data.hero as any)?.announcement as
	| { text: string; link: string }
	| undefined;
const hasImage = Boolean(image);
const tagline = heroTagline || data.description;

const imageAttrs = {
	loading: 'eager' as const,
	decoding: 'async' as const,
	alt: image?.alt || '',
};

let darkImage: ImageMetadata | undefined;
let lightImage: ImageMetadata | undefined;
let rawHtml: string | undefined;

if (image) {
	if ('file' in image) {
		darkImage = image.file;
	} else if ('dark' in image) {
		darkImage = image.dark;
		lightImage = image.light;
	} else {
		rawHtml = image.html;
	}
}
---

<div class="container-section">
	<div class="container-wrapper">
		<div class="container">
			<section class="hero" data-layout={heroLayout} data-has-image={hasImage ? '' : undefined}>
				{
					hasImage && (
						<div class="hero-image">
							{darkImage && (
								<Image
									src={darkImage}
									{...imageAttrs}
									class:list={{ 'light:sl-hidden': Boolean(lightImage) }}
								/>
							)}
							{lightImage && <Image src={lightImage} {...imageAttrs} class="dark:sl-hidden" />}
							{rawHtml && <div class="hero-html sl-flex" set:html={rawHtml} />}
						</div>
					)
				}

				<div class="hero-info">
					<div class="hero-title-container">
						{
							announcement && (
								<a class="link-button secondary" data-size="2xs" href={announcement.link}>
									{announcement.text}
									<Icon name="right-arrow" size="16px" />
								</a>
							)
						}

						<h1 id="_top" data-page-title set:html={title} />
					</div>

					<div class="hero-content-container">
						{tagline && <div class="tagline" set:html={tagline} />}

						{
							actions.length > 0 && (
								<div class="actions">
									{actions.map(
										({
											attrs: { class: className, ...attrs } = {},
											icon,
											link: href,
											text,
											variant,
										}) => (
											<a
												class:list={['link-button', variant, className]}
												data-size="md"
												href={href}
												{...attrs}
											>
												{text}
												{icon?.name && <Icon name={icon.name} size="16px" />}
												{icon?.html && <Fragment set:html={icon.html} />}
											</a>
										)
									)}
								</div>
							)
						}
					</div>
				</div>
			</section>
		</div>
	</div>
</div>

<style>
	.container-section {
		padding-inline: calc(var(--spacing) * 2);

		@media (min-width: 640px) {
			padding-inline: calc(var(--spacing) * 4);
		}

		@media (min-width: 1024px) {
			padding-inline: calc(var(--spacing) * 12);
		}

		.container-wrapper {
			max-width: 1024px;
		}
	}

	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding-block: calc(var(--spacing) * 20);
		gap: calc(var(--spacing) * 12);
	}

	.hero-image {
		max-width: 100%;
		width: 100%;
	}

	.hero-image img {
		width: 100%;
		height: auto;
		aspect-ratio: attr(width) / attr(height);
		border-radius: var(--radius);
	}

	.hero-info {
		display: flex;
		text-align: center;
		align-items: center;
		flex-direction: column;
		gap: calc(var(--spacing) * 2);

		@media (min-width: 768px) {
			gap: calc(var(--spacing) * 4);
		}
	}

	.hero-title-container {
		display: flex;
		flex-direction: column;
		gap: calc(var(--spacing) * 2);
		align-items: center;

		h1 {
			font-size: 1.875rem;
			font-weight: 600;
			line-height: 1.1;
			text-wrap-style: balance;
			letter-spacing: var(--spacing-tighter);
		}

		@media (min-width: 768px) {
			gap: calc(var(--spacing) * 4);

			h1 {
				font-size: 3rem;
			}
		}
	}

	.hero-content-container {
		display: flex;
		flex-direction: column;
		gap: calc(var(--spacing) * 2);

		.tagline {
			max-width: 56rem;
			font-size: 1.125rem;
			text-wrap: balance;
			line-height: 1.75rem;
		}

		.actions {
			display: flex;
			justify-content: center;
			padding-top: calc(var(--spacing) * 2);
			gap: calc(var(--spacing) * 2);
		}

		@media (min-width: 768px) {
			gap: calc(var(--spacing) * 4);
		}
	}

	.link-button {
		transition-property: color, background-color, border-color, text-decoration-color, fill, stroke;
		transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
		transition-duration: 0.15s;
		color: var(--primary-foreground);
		white-space: nowrap;
		gap: 0.5rem;
		justify-content: center;
		align-items: center;
		display: inline-flex;
		text-decoration: inherit;
		border: none;
		height: var(--button-height, calc(var(--spacing) * 8));
		width: var(--button-width, auto);
		font-weight: var(--button-font-weight, 500);
		font-size: var(--button-font-size, 0.875rem);
		line-height: var(--button-line-height, 1rem);
		padding-left: var(--button-padding-l, var(--button-padding-x, calc(var(--spacing) * 2.5)));
		padding-right: var(--button-padding-r, var(--button-padding-x, calc(var(--spacing) * 2.5)));
		border-radius: var(--button-radius, var(--radius));
	}

	.link-button[data-size='2xs'] {
		--button-height: calc(var(--spacing) * 5.5);
		--button-padding-l: calc(var(--spacing) * 2);
		--button-padding-r: var(--spacing);
		--button-font-size: 0.75rem;
	}

	.primary {
		background-color: var(--primary);
	}

	.primary:hover {
		background-color: color-mix(in oklab, var(--primary) 90%, transparent);
	}

	.secondary {
		background-color: var(--secondary);
		color: var(--secondary-foreground);
	}

	.secondary:hover {
		background-color: color-mix(in oklab, var(--secondary) 80%, transparent);
	}

	.minimal {
		color: var(--accent-foreground);
	}

	.minimal:hover {
		color: var(--accent-foreground);
		background-color: var(--accent);
	}

	.hero[data-layout='centered-top'],
	.hero[data-layout='banner'] {
		flex-direction: column-reverse;
		gap: calc(var(--spacing) * 20);
		padding-block-end: calc(var(--spacing) * 8);
	}

	.hero[data-layout='banner'] {
		@media (min-width: 1024px) {
			.hero-info {
				width: 100%;
				flex-direction: row;
				gap: calc(var(--spacing) * 16);

				.hero-title-container {
					flex: 1;
					align-items: flex-start;
					text-align: left;
				}

				.hero-content-container {
					flex: 1;
					align-items: flex-start;
					align-self: flex-end;
					text-align: left;
				}
			}
		}
	}

	.hero[data-layout='split-left'],
	.hero[data-layout='split-right'] {
		flex-direction: column;

		.hero-image {
			order: 0;
		}

		@media (min-width: 1024px) {
			flex-direction: row;
			gap: calc(var(--spacing) * 16);

			.hero-info {
				align-items: flex-start;

				.hero-title-container,
				.hero-content-container {
					align-items: flex-start;
					text-align: left;
				}
			}
		}
	}

	.hero[data-layout='split-left'] {
		.hero-image {
			order: 1;
		}
	}
</style>
