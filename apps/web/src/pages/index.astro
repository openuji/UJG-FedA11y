---
import 'lucode-starlight/styles/layers';
import 'lucode-starlight/styles/theme';
import 'lucode-starlight/styles/base';
import './index.css';
import ThemeProvider from '@astrojs/starlight/components/ThemeProvider.astro';
import Header from 'virtual:starlight/components/Header';
import filesharingAccessibility from '../assets/accessibility/filesharing-accessibility.json';
import filesharingJsonldUrl from '../assets/ujg/filesharing.ujg.jsonld?url';
import filesharingYamlUrl from '../assets/ujg/filesharing.ujg.yaml?url';
import JourneyAccessibilityIntro from '../components/JourneyAccessibilityIntro.astro';
import JourneyPathIsland from '../components/JourneyPathIsland';

(Astro.locals as any).starlightRoute = {
	siteTitle: 'UJG-FedA11y',
	siteTitleHref: '/docs/',
};

(Astro.locals as any).t = Object.assign(
	(key: string) =>
		({
			'search.label': 'Search',
			'search.ctrlKey': 'Ctrl',
			'search.cancelLabel': 'Cancel',
			'search.devWarning': 'Search is only available after building the site.',
			'themeSelect.accessibleLabel': 'Select theme',
		})[key] ?? key,
	{ all: () => ({}) }
);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="UJG Federation Accessibility"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>UJG-FedA11y</title>
    <ThemeProvider />
  </head>
  <body>
    <div data-slot="layout">
      <header class="site-header">
        <div class="container-wrapper px-6">
          <div class="container">
            <Header />
          </div>
        </div>
      </header>

      <main>
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero__content">
            <p class="hero__eyebrow">UJG-FedA11y</p>
            <h1 id="hero-title">UJG-FedA11y</h1>
            <p class="hero__tagline">Test accessibility across federated services</p>
            <p class="hero__description">
              Describe a user journey, run it against real services, and inspect the result of each step.
            </p>
            <div class="hero__actions" aria-label="Primary links">
              <a class="button button--primary" href="#demo">See the demo</a>
              <a class="button button--secondary" href="https://github.com/openuji/UJG-FedA11y">View on GitHub</a>
            </div>
          </div>
        </section>

        <article id="demo" class="demo-article" aria-labelledby="demo-title">
          <header class="demo-intro header">
            <p class="eyebrow">Demo</p>
            <h2 id="demo-title">Example demo</h2>
            <h3>Share a file between two Nextcloud servers</h3>
            <p>Alice shares a file from Nextcloud A. Bob receives it in Nextcloud B.</p>
          </header>

          <JourneyAccessibilityIntro accessibilityDocument={filesharingAccessibility} />

          <section class="journey-panel" aria-labelledby="journey-path-title">
            <div class="journey-panel__header header">
              <h3 id="journey-path-title">User Journey Graph</h3>
              <div class="journey-panel__links" aria-label="User Journey Graph source files">
                <a class="journey-panel__source-link" href={filesharingJsonldUrl}>
                  <span class="journey-panel__source-mark">JSON</span>
                  <span>ujg.jsonld</span>
                </a>
                <a class="journey-panel__source-link" href={filesharingYamlUrl}>
                  <span class="journey-panel__source-mark">YAML</span>
                  <span>ujg.yaml</span>
                </a>
              </div>
            </div>
            <JourneyPathIsland accessibilityDocument={filesharingAccessibility} client:load />
          </section>
        </article>
      </main>
    </div>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    min-height: 100%;
    background: var(--background);
    color: var(--foreground);
    font-family:
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .sl-flex {
    display: flex;
  }

  .sl-hidden {
    display: none;
  }

  @media (min-width: 768px) {
    .md\:sl-flex {
      display: flex !important;
    }
  }
</style>

<style>
  [data-slot='layout'] {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    background: var(--background);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    background: var(--background);
  }

  .site-header .container-wrapper {
    padding-inline: calc(var(--spacing) * 6);
  }

  .site-header .container {
    display: flex;
    height: var(--header-height);
    align-items: center;
    max-width: none;
  }

  main {
    flex: 1;
    display: grid;
    gap: clamp(4rem, 9vw, 7rem);
    padding: clamp(3rem, 7vw, 6rem) calc(var(--spacing) * 6) calc(var(--spacing) * 12);
    width: 100%;
    max-width: var(--container-max-width);
    min-width: 0;
    margin-inline: auto;
  }

  .hero {
    display: grid;
    align-items: center;
    min-height: min(38rem, calc(100svh - var(--header-height) - 4rem));
    min-width: 0;
    padding-block: clamp(2rem, 6vw, 5rem);
  }

  .hero__content {
    max-width: 56rem;
  }

  .hero__eyebrow {
    margin: 0 0 calc(var(--spacing) * 4);
    color: var(--blue);
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .hero h1,
  .demo-intro h2 {
    margin: 0;
    color: var(--foreground);
    font-weight: 850;
    letter-spacing: 0;
    line-height: 1;
  }

  .hero h1 {
    font-size: clamp(3.5rem, 9vw, 7.5rem);
  }

  .hero__tagline {
    max-width: 48rem;
    margin: calc(var(--spacing) * 5) 0 0;
    color: var(--foreground);
    font-size: clamp(1.45rem, 3vw, 2.4rem);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.12;
  }

  .hero__description,
  .demo-intro p {
    color: var(--muted-foreground);
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .hero__description {
    max-width: 42rem;
    margin: calc(var(--spacing) * 4) 0 0;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--spacing) * 3);
    margin-top: calc(var(--spacing) * 8);
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: calc(var(--spacing) * 2) calc(var(--spacing) * 5);
    border: 1px solid color-mix(in oklab, var(--border) 74%, transparent);
    border-radius: var(--radius);
    font-size: 0.9375rem;
    font-weight: 750;
    line-height: 1.2;
    text-decoration: none;
  }

  .button--primary {
    border-color: color-mix(in oklab, var(--blue) 72%, var(--border));
    background: var(--blue);
    color: var(--background);
  }

  .button--secondary {
    background: color-mix(in oklab, var(--card) 88%, var(--background));
    color: var(--foreground);
  }

  .button:hover {
    transform: translateY(-1px);
  }

  .button:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 0.25rem;
  }

  .journey-panel h2,
  .journey-panel h3 {
    margin: 0;
    color: var(--foreground);
    line-height: 1.1;
  }

  .eyebrow {
    margin: 0 0 calc(var(--spacing) * 3);
    color: var(--muted-foreground);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  article {
    width: 100%;
    max-width: 1120px;
    min-width: 0;
    margin-inline: auto;
    padding: 0 calc(var(--spacing) * 6) calc(var(--spacing) * 6);
  }

  .demo-article {
    scroll-margin-top: calc(var(--header-height) + 2rem);
  }

  .demo-intro {
    display: grid;
    gap: calc(var(--spacing) * 3);
    margin-bottom: calc(var(--spacing) * 8);
    text-align: left;
  }

  .demo-intro .eyebrow {
    margin-bottom: 0;
  }

  .demo-intro h2 {
    font-size: clamp(2rem, 5vw, 4rem);
  }

  .demo-intro h3 {
    margin: calc(var(--spacing) * 2) 0 0;
    color: var(--foreground);
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    letter-spacing: 0;
    line-height: 1.2;
  }

  .demo-intro p {
    max-width: 42rem;
    margin: 0;
  }

  .journey-panel {
    display: grid;
    gap: calc(var(--spacing) * 6);
    width: 100%;
    max-width: 100%;
    min-width: 0;
    
    background: color-mix(in oklab, var(--background) 88%, var(--card));
    
  }

  .journey-panel__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: calc(var(--spacing) * 3);
  }

  .journey-panel h2,
  .journey-panel h3 {
    font-size: 1.25rem;
  }

  .journey-panel__links {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: calc(var(--spacing) * 2);
  }

  .journey-panel__source-link {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--spacing) * 2);
    min-height: 2rem;
    padding: calc(var(--spacing) * 1) calc(var(--spacing) * 2);
    border: 1px solid color-mix(in oklab, var(--border) 76%, transparent);
    border-radius: 999px;
    background:
      linear-gradient(
        180deg,
        color-mix(in oklab, var(--card) 94%, var(--foreground) 6%),
        color-mix(in oklab, var(--card) 86%, var(--background))
      );
    box-shadow: 0 1px 2px color-mix(in oklab, var(--background) 70%, transparent);
    color: color-mix(in oklab, var(--foreground) 88%, var(--muted-foreground));
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
  }

  .journey-panel__source-mark {
    display: inline-grid;
    place-items: center;
    min-width: 2.45rem;
    min-height: 1.25rem;
    padding-inline: calc(var(--spacing) * 1);
    border: 1px solid color-mix(in oklab, var(--blue) 38%, var(--border));
    border-radius: 999px;
    background: color-mix(in oklab, var(--blue-low) 38%, transparent);
    color: var(--blue);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .journey-panel__source-link:hover {
    border-color: color-mix(in oklab, var(--blue) 52%, var(--border));
    color: var(--foreground);
    transform: translateY(-1px);
  }

  .journey-panel__source-link:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 0.25rem;
  }

  @media (max-width: 640px) {
    .site-header .container-wrapper {
      padding-inline: calc(var(--spacing) * 4);
    }

    main {
      gap: calc(var(--spacing) * 14);
      padding: calc(var(--spacing) * 10) calc(var(--spacing) * 4);
    }

    .hero {
      min-height: auto;
      padding-block: calc(var(--spacing) * 6);
    }

    .hero__actions,
    .button {
      width: 100%;
    }

    article {
      padding-inline: 0;
    }

    .journey-panel__header {
      align-items: flex-start;
      flex-direction: column;
      gap: calc(var(--spacing) * 2);
    }

    .journey-panel__links {
      justify-content: flex-start;
    }
  }

  .demo-article {
    
  }

  :global(.journey-path-island) {
    --color-surface: var(--card);
    --color-surface-muted: var(--muted);
    --color-foreground: var(--foreground);
    --color-foreground-muted: var(--muted-foreground);
    --color-border: var(--border);
    --color-border-mute: color-mix(in oklab, var(--border) 55%, transparent);
    --color-accent: var(--blue);
    --color-accent-muted: var(--blue-low);
    --color-success: var(--green);
    --color-success-muted: var(--green-low);
    --color-warning: var(--orange);
    --color-warning-muted: var(--orange-low);
    --color-danger: var(--red);
    --color-danger-muted: var(--red-low);
    min-width: max-content;
  }
</style>
