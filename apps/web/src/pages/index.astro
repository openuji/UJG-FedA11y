---
import 'lucode-starlight/styles/layers';
import 'lucode-starlight/styles/theme';
import 'lucode-starlight/styles/base';

import ThemeProvider from '@astrojs/starlight/components/ThemeProvider.astro';
import Header from 'virtual:starlight/components/Header';
import filesharingAccessibility from '../assets/accessibility/filesharing-accessibility.json';
import JourneyAccessibilityIntro from '../components/JourneyAccessibilityIntro.astro';
import JourneyPathIsland from '../components/JourneyPathIsland';

(Astro.locals as any).starlightRoute = {
	siteTitle: 'UJG-FedA11y',
	siteTitleHref: '/docs/',
};

(Astro.locals as any).t = Object.assign(
	(key: string) =>
		({
			'search.label': 'Search',
			'search.ctrlKey': 'Ctrl',
			'search.cancelLabel': 'Cancel',
			'search.devWarning': 'Search is only available after building the site.',
			'themeSelect.accessibleLabel': 'Select theme',
		})[key] ?? key,
	{ all: () => ({}) }
);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="UJG Federation Accessibility"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>UJG-FedA11y</title>
    <ThemeProvider />
  </head>
  <body>
    <div data-slot="layout">
      <header>
        <div class="container-wrapper px-6">
          <div class="container">
            <Header />
          </div>
        </div>
      </header>

      <main>
        <JourneyAccessibilityIntro accessibilityDocument={filesharingAccessibility} />

        <section class="journey-panel" aria-labelledby="journey-path-title">
          <div class="journey-panel__header">
            <p class="eyebrow">Journey path</p>
            <h2 id="journey-path-title">Federated file sharing</h2>
          </div>
          <JourneyPathIsland accessibilityDocument={filesharingAccessibility} client:load />
        </section>
      </main>
    </div>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    min-height: 100%;
    background: var(--background);
    color: var(--foreground);
    font-family:
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .sl-flex {
    display: flex;
  }

  .sl-hidden {
    display: none;
  }

  @media (min-width: 768px) {
    .md\:sl-flex {
      display: flex !important;
    }
  }
</style>

<style>
  [data-slot='layout'] {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    background: var(--background);
  }

  header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    background: var(--background);
  }

  header .container-wrapper {
    padding-inline: calc(var(--spacing) * 6);
  }

  header .container {
    display: flex;
    height: var(--header-height);
    align-items: center;
    max-width: none;
  }

  main {
    flex: 1;
    padding: calc(var(--spacing) * 10) calc(var(--spacing) * 6);
    width: 100%;
    max-width: var(--container-max-width);
    margin-inline: auto;
  }

  .journey-panel h2 {
    margin: 0;
    color: var(--foreground);
    line-height: 1.1;
  }

  .eyebrow {
    margin: 0 0 calc(var(--spacing) * 3);
    color: var(--muted-foreground);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .journey-panel {
    display: grid;
    gap: calc(var(--spacing) * 6);
    min-width: 0;
    max-width: 100%;
    overflow-x: auto;
    padding: calc(var(--spacing) * 6);
    background: color-mix(in oklab, var(--background) 88%, var(--card));
  }

  .journey-panel__header {
    display: grid;
    gap: calc(var(--spacing) * 1);
  }

  .journey-panel h2 {
    font-size: 1.25rem;
  }

  :global(.journey-path-island) {
    --color-surface: var(--card);
    --color-surface-muted: var(--muted);
    --color-foreground: var(--foreground);
    --color-foreground-muted: var(--muted-foreground);
    --color-border: var(--border);
    --color-border-mute: color-mix(in oklab, var(--border) 55%, transparent);
    --color-accent: var(--blue);
    --color-accent-muted: var(--blue-low);
    --color-success: var(--green);
    --color-success-muted: var(--green-low);
    --color-warning: var(--orange);
    --color-warning-muted: var(--orange-low);
    --color-danger: var(--red);
    --color-danger-muted: var(--red-low);
    min-width: max-content;
  }
</style>
