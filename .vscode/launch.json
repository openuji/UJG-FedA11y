{
  "version": "0.2.0",
  "configurations": [    
    {
      "name": "Playwright: Debug current spec",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/tests/federation/node_modules/@playwright/test/cli.js",
      "args": ["test", "${file}", "--project=chromium", "--workers=1","--config=${workspaceFolder}/tests/federation" ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Playwright: Inspector current spec",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/tests/federation/node_modules/@playwright/test/cli.js",
      "args": ["test", "${file}", "--project=chromium", "--debug"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
